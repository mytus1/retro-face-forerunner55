<?xml version="1.0"?>
<!-- Apogee, private beta build (separate app id, as Garmin requires for beta uploads).
     Keep everything else identical to manifest.xml. -->
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
    <iq:application id="7bf0bbe5-4e47-4419-a6ea-8899ca0041aa" type="watchface" name="@Strings.AppName" entry="ApogeeApp" launcherIcon="@Drawables.LauncherIcon" minApiLevel="3.2.0">
        <iq:products>
            <iq:product id="fr55"/>
        </iq:products>
        <!-- UserProfile: needed for the VO2 max and resting heart rate fields -->
        <iq:permissions>
            <iq:uses-permission id="UserProfile"/>
        </iq:permissions>
        <iq:languages>
            <iq:language>eng</iq:language>
        </iq:languages>
        <iq:barrels/>
    </iq:application>
</iq:manifest>
